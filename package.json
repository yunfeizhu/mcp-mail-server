{
  "name": "mcp-mail-server",
  "version": "2.0.1",
  "description": "MCP server for IMAP/SMTP email access with environment-based configuration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-mail-server": "dist/index.js"
  },
  "scripts": {
    "build": "npm run typecheck && tsx scripts/build.ts",
    "build:dev": "tsx scripts/watch.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "clean": "tsx scripts/clean.ts",
    "typecheck": "tsc --noEmit && tsc --project test/tsconfig.json",
    "dev": "npm run build:dev",
    "dev:inspector": "npm run build && mcp-inspector",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "tsx scripts/test.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run format:check"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "README-zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "imap",
    "smtp",
    "email",
    "mail",
    "server",
    "cursor",
    "claude",
    "model-context-protocol"
  ],
  "author": "zhuyunfei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunfeizhu/mcp-mail-server.git"
  },
  "homepage": "https://github.com/yunfeizhu/mcp-mail-server#readme",
  "bugs": {
    "url": "https://github.com/yunfeizhu/mcp-mail-server/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imap": "^0.8.19",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "1.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/imap": "^0.8.42",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "rollup": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "utf7": {
      "semver": "^7.8.5"
    }
  }
}
